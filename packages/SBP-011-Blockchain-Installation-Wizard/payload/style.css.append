.wizard-steps{display:grid;grid-template-columns:repeat(5,1fr);gap:6px;padding:0;list-style:none}.wizard-steps li,.wizard-section{padding:10px;border:1px solid var(--border);border-radius:9px}.wizard-steps li.active{background:var(--accent-dark);color:var(--accent)}.wizard-section{margin:18px 0}.wizard-section label{display:grid;gap:6px;margin:10px 0;color:var(--muted)}.wizard-section input{padding:10px;border:1px solid var(--border);border-radius:8px;background:#08131d;color:var(--text)}.wizard-install{width:100%;padding:13px;border:0;border-radius:10px}
