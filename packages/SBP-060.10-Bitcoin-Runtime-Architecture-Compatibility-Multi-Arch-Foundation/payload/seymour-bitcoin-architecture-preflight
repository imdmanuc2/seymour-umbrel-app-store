#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

REPO = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(REPO / "shared"))

from runtime_architecture import architecture_report

DEFAULT_IMAGE = "ghcr.io/imdmanuc2/seymour-bitcoin-node:29.0.0"

parser = argparse.ArgumentParser()
parser.add_argument("--image", default=DEFAULT_IMAGE)
parser.add_argument("--require-compatible", action="store_true")
args = parser.parse_args()

report = architecture_report(args.image).to_dict()
report["status"] = (
    "compatible"
    if report["compatible"]
    else "architecture-mismatch"
    if report["inspectAvailable"]
    else "inspection-unavailable"
)

print(json.dumps(report, indent=2))

if args.require_compatible and not report["compatible"]:
    raise SystemExit(2)
