  "sourceContract": "seymour.app-lifecycle-execution/1.0",
  "purpose": "Stable lifecycle operational event projection",
  "eventTypes": [
    "lifecycle.action.planned",
    "lifecycle.action.rejected",
    "lifecycle.action.blocked",
