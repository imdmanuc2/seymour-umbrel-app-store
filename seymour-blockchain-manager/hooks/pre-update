#!/usr/bin/env bash
set -euo pipefail

fail()
{
    echo "Seymour Blockchain Manager pre-update: $*" >&2
    exit 1
}

[[ -n "${SCRIPT_APP_REPO_DIR:-}" ]] ||
    fail "SCRIPT_APP_REPO_DIR is not set"

if [[ -n "${APP_DATA_DIR:-}" ]]; then
    RESOLVED_APP_DATA_DIR="${APP_DATA_DIR%/}"
    APP_DATA_DIR_SOURCE="environment"
else
    HOOK_DIR="$(
        cd -- "$(dirname -- "${BASH_SOURCE[0]}")" >/dev/null 2>&1 &&
        pwd -P
    )" ||
        fail "unable to resolve installed hook directory"

    RESOLVED_APP_DATA_DIR="$(
        cd -- "${HOOK_DIR}/.." >/dev/null 2>&1 &&
        pwd -P
    )" ||
        fail "unable to resolve installed app directory"

    APP_DATA_DIR_SOURCE="hook-location"
fi

SOURCE_ROOT="${SCRIPT_APP_REPO_DIR%/}/data"
DEST_ROOT="${RESOLVED_APP_DATA_DIR%/}/data"

# This hook is invoked by Umbrel's native app lifecycle authority.
# Prepare the persistent machine-control TLS bind source before Docker
# can auto-create it as root:root. Keep this operation intentionally
# bounded to Seymour Blockchain Manager's own private TLS directory.
TLS_PRIVATE_DIR="${RESOLVED_APP_DATA_DIR%/}/data/private/nexus-control-tls"

[[ "$SCRIPT_APP_REPO_DIR" = /* ]] ||
    fail "SCRIPT_APP_REPO_DIR must be absolute"

[[ "$RESOLVED_APP_DATA_DIR" = /* ]] ||
    fail "resolved app directory must be absolute"

[[ "$(basename -- "$RESOLVED_APP_DATA_DIR")" = "seymour-blockchain-manager" ]] ||
    fail "resolved app directory is not Seymour Blockchain Manager: $RESOLVED_APP_DATA_DIR"

[[ -d "$SOURCE_ROOT" ]] ||
    fail "packaged data directory not found: $SOURCE_ROOT"

[[ -d "$RESOLVED_APP_DATA_DIR" ]] ||
    fail "installed app directory not found: $RESOLVED_APP_DATA_DIR"

command -v rsync >/dev/null 2>&1 ||
    fail "rsync is required"

[[ "$TLS_PRIVATE_DIR" = "${RESOLVED_APP_DATA_DIR%/}/data/private/nexus-control-tls" ]] ||
    fail "unexpected TLS private directory: $TLS_PRIVATE_DIR"

[[ ! -L "$TLS_PRIVATE_DIR" ]] ||
    fail "TLS private directory must not be a symlink: $TLS_PRIVATE_DIR"

mkdir -p "$TLS_PRIVATE_DIR"

[[ -d "$TLS_PRIVATE_DIR" ]] ||
    fail "TLS private directory is not a directory: $TLS_PRIVATE_DIR"

APP_DATA_UID="$(stat -c '%u' "$RESOLVED_APP_DATA_DIR")"
APP_DATA_GID="$(stat -c '%g' "$RESOLVED_APP_DATA_DIR")"

[[ "$APP_DATA_UID" =~ ^[0-9]+$ ]] ||
    fail "invalid installed app uid: $APP_DATA_UID"

[[ "$APP_DATA_GID" =~ ^[0-9]+$ ]] ||
    fail "invalid installed app gid: $APP_DATA_GID"

chown "${APP_DATA_UID}:${APP_DATA_GID}" "$TLS_PRIVATE_DIR"
chmod 0700 "$TLS_PRIVATE_DIR"

mkdir -p "$DEST_ROOT"

for component in catalog control shared web
do
    source_dir="$SOURCE_ROOT/$component"
    destination_dir="$DEST_ROOT/$component"

    [[ -d "$source_dir" ]] ||
        fail "packaged component not found: $source_dir"

    mkdir -p "$destination_dir"

    rsync \
        --archive \
        --exclude '.gitkeep' \
        "$source_dir/." \
        "$destination_dir/"
done

echo "Seymour Blockchain Manager pre-update: release payload synchronized via ${APP_DATA_DIR_SOURCE}."
