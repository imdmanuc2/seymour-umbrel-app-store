#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT))

from shared.bitcoin_managed_runtime import (
    BitcoinManagedRuntimeWorkflow,
)


def main() -> None:
    parser = argparse.ArgumentParser()

    parser.add_argument(
        "action",
        choices=[
            "install-plan",
            "install",
            "start-plan",
            "start",
        ],
    )

    parser.add_argument(
        "--data-path",
        type=Path,
        default=Path(
            "/mnt/seymour-storage/"
            "bitcoin-mainnet"
        ),
    )

    parser.add_argument(
        "--confirm",
    )

    args = parser.parse_args()

    workflow = BitcoinManagedRuntimeWorkflow(
        repository=ROOT,
        data_path=args.data_path,
    )

    if args.action == "install-plan":
        result = workflow.install_plan()

    elif args.action == "install":
        result = workflow.install(
            confirmation=args.confirm or "",
        )

    elif args.action == "start-plan":
        result = workflow.start_plan()

    else:
        result = workflow.start(
            confirmation=args.confirm or "",
        )

    print(
        json.dumps(
            result,
            indent=2,
        )
    )

    if (
        isinstance(result, dict)
        and result.get("success") is False
    ):
        raise SystemExit(1)


if __name__ == "__main__":
    main()
