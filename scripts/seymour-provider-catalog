#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
import platform
from pathlib import Path

from shared.provider_catalog import ProviderCatalog


def normalized_architecture() -> str:
    machine = platform.machine().lower()

    if machine in {"x86_64", "amd64"}:
        return "amd64"

    if machine in {"aarch64", "arm64"}:
        return "arm64"

    return machine


def main() -> None:
    parser = argparse.ArgumentParser(
        description="Inspect the Seymour Umbrel provider catalog."
    )
    parser.add_argument(
        "--catalog",
        default=str(
            Path(__file__).resolve().parents[1]
            / "shared"
            / "provider_catalog"
            / "providers.v1.json"
        ),
    )

    sub = parser.add_subparsers(
        dest="command",
        required=True,
    )

    sub.add_parser("list")
    sub.add_parser("api")
    sub.add_parser("selectable")

    show = sub.add_parser("show")
    show.add_argument("provider_id")

    validate = sub.add_parser("validate-selection")
    validate.add_argument("provider_id")
    validate.add_argument(
        "--architecture",
        default=normalized_architecture(),
    )

    args = parser.parse_args()
    catalog = ProviderCatalog.load(
        Path(args.catalog)
    )

    if args.command == "list":
        payload = [
            provider.to_api_dict()
            for provider in catalog.providers
        ]
    elif args.command == "api":
        payload = catalog.api_payload()
    elif args.command == "selectable":
        payload = [
            provider.to_api_dict()
            for provider in catalog.selectable()
        ]
    elif args.command == "show":
        payload = catalog.get(
            args.provider_id
        ).to_api_dict()
    else:
        provider = catalog.validate_install_selection(
            args.provider_id,
            args.architecture,
        )
        payload = {
            "valid": True,
            "provider": provider.to_api_dict(),
            "architecture": args.architecture,
        }

    print(json.dumps(payload, indent=2))


if __name__ == "__main__":
    main()
