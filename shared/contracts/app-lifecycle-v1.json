{
  "contract": "seymour.app-lifecycle",
  "version": "1.0",
  "actions": [
    "install",
    "start",
    "stop",
    "restart",
    "update",
    "uninstall"
  ],
  "states": [
    "not-installed",
    "installing",
    "stopped",
    "starting",
    "running",
    "restarting",
    "updating",
    "uninstalling",
    "degraded",
    "error",
    "unknown"
  ],
  "writeOperationsRequireConfirmation": true,
  "directDockerLifecycle": false,
  "nativeUmbrelLifecyclePreferred": true
}
