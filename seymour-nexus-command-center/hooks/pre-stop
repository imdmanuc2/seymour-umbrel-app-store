#!/bin/sh

APP_ID="seymour-nexus-command-center"
APP_DATA_DIR="/home/umbrel/umbrel/app-data/$APP_ID"
ADVERTISER="$APP_DATA_DIR/hooks/nexus-discovery-advertiser.sh"
PID_FILE="$APP_DATA_DIR/data/runtime/nexus-discovery-advertiser.pid"

if [ ! -r "$PID_FILE" ]; then
    exit 0
fi

PID="$(cat "$PID_FILE" 2>/dev/null || true)"

if [ -n "$PID" ] && kill -0 "$PID" 2>/dev/null; then
    OWNER="$(ps -o user= -p "$PID" 2>/dev/null | tr -d ' ')"
    COMMAND="$(ps -o args= -p "$PID" 2>/dev/null || true)"

    case "$COMMAND" in
        *"$ADVERTISER"*)
            if [ "$OWNER" = "umbrel" ]; then
                kill "$PID" 2>/dev/null || true
            fi
            ;;
    esac
fi

rm -f "$PID_FILE"
